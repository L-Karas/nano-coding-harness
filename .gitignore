# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Dotfiles at any depth (covers .venv, .env, /.idea, /.claude, etc.)
.*
!.mcp/

# docs
/docs

# Temp
/examples/*
/test
/skills/*
/log
/tests

# Track only .py files under src
/core/**
!/core/**/
!/core/**/*.py
/core/tui/demo.py
!/core/tui/app.css
!/core/client/models.json
!.gitattributes
/core/tui/smoke/
