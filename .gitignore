# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Dotfiles at any depth (covers .venv, .env, /.idea, /.claude, etc.)
.*
!.mcp/

# Temp
/skills/*
/log
/docs
/temp

# Track only .py files under src
/core/**
!/core/**/
!/core/**/*.py
!/core/tui/app.css
!/core/client/models.json
!.gitattributes
